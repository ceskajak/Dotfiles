# ~/.zshrc — managed by chezmoi.
# host {{ .chezmoi.hostname }} · role {{ .role }} · wm {{ .wm }} · os {{ .chezmoi.osRelease.id }}
#
# NOTE (2026-10-08): fast-syntax-highlighting is the fleet's one highlighter,
# themed with upstream Catppuccin Macchiato (dot_config/fsh/, activated by
# run_onchange_after_29-fsh-theme.sh.tmpl). The prompt is "fishy-macchiato"
# (dot_oh-my-zsh/custom/themes): fishy's layout, fixed Macchiato hex colours so
# it is terminal-agnostic. Layout confirmed (minimal was considered, declined).
# Plugins are runtime-guarded so a missing one is skipped instead of erroring.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="fishy-macchiato"

# plugins — start minimal, append only the custom ones actually installed
plugins=(git{{ if eq .chezmoi.osRelease.id "fedora" }} dnf{{ end }})
ZSHC=${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}
[ -d $ZSHC/plugins/zsh-autosuggestions ]      && plugins+=(zsh-autosuggestions)
[ -d $ZSHC/plugins/fast-syntax-highlighting ] && plugins+=(fast-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# user binaries on PATH — all machines
export PATH="$HOME/.local/bin:$PATH"

# ls colours — fixed Catppuccin Macchiato truecolor values (terminal-agnostic)
_ls_arch=237\;135\;150 _ls_img=198\;160\;246 _ls_media=139\;213\;202
LS_COLORS="di=1;38;2;138;173;244:ln=38;2;245;189;230:or=1;38;2;237;135;150:mi=1;38;2;237;135;150"
LS_COLORS+=":ex=1;38;2;166;218;149:pi=38;2;238;212;159:so=38;2;245;189;230:bd=38;2;238;212;159:cd=38;2;238;212;159"
LS_COLORS+=":su=38;2;36;39;58;48;2;237;135;150:sg=38;2;36;39;58;48;2;237;135;150"
LS_COLORS+=":tw=38;2;36;39;58;48;2;166;218;149:ow=38;2;36;39;58;48;2;166;218;149:st=38;2;36;39;58;48;2;138;173;244"
for e in tar tgz gz xz bz2 zip 7z zst rar; do LS_COLORS+=":*.$e=38;2;$_ls_arch"; done
for e in png jpg jpeg gif svg webp; do LS_COLORS+=":*.$e=38;2;$_ls_img"; done
for e in mp3 flac ogg wav mp4 mkv webm; do LS_COLORS+=":*.$e=38;2;$_ls_media"; done
export LS_COLORS
unset _ls_arch _ls_img _ls_media e

# default editor — resolved to the real binary (not just an alias) so
# non-interactive invocations (git, sudoedit, systemctl edit, ...) get the
# right one too; aliases only apply in interactive shells.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR='nvim'
  alias vim='nvim'
elif command -v vim >/dev/null 2>&1; then
  export EDITOR='vim'
fi
export VISUAL="$EDITOR"

# personal SSH aliases
alias sunrise='ssh -AYCt ceskajak@sunrise.fjfi.cvut.cz'
alias star='ssh -AYCt ceskajak@sssh.sdcc.bnl.gov'
alias star_node='f(){ssh -AYCt ceskajak@sssh.sdcc.bnl.gov ssh rcas"$@";}; f'
alias eic='ssh -AYCt ceska@sssh.sdcc.bnl.gov'
alias pi='ssh -AYCt pi'
{{ if eq .role "workstation" }}
# --- workstation-only ({{ .chezmoi.hostname }}), each guarded ---
[ -f ~/.openclaw/completions/openclaw.zsh ] && source ~/.openclaw/completions/openclaw.zsh
[ -x /home/linuxbrew/.linuxbrew/bin/brew ]  && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
[ -d ~/.opencode/bin ] && export PATH="$HOME/.opencode/bin:$PATH"
{{ end }}
# per-machine overrides (not tracked)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
