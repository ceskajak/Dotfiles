#!/bin/bash
# Open Bar settings — one shared set for all GNOME hosts (ocean, akvarium);
# wm=gnome only. Source: ocean's config 2026-10-08. Per-monitor size and
# reload-state keys are deliberately left out.
set -e
{{ if eq .wm "gnome" -}}
dconf load /org/gnome/shell/extensions/openbar/ <<'EOF'
[/]
accent-color=['0.835', '0.38', '0.6']
accent-override=true
apply-accent-shell=false
apply-all-shell=false
apply-menu-notif=false
apply-menu-shell=false
autohg-bar=true
bartype='Floating'
bcolor=['0.835', '0.38', '0.6']
bg-change=false
bgalpha=0.90000000000000002
bgcolor=['0.125', '0.125', '0.125']
bgcolor-wmax=['0.125', '0.125', '0.125']
bgcolor2=['0.835', '0.38', '0.6']
bguri='file:///usr/share/backgrounds/f43/default/f43-01-night.jxl'
boxcolor=['0.125', '0.125', '0.125']
bwidth=1.0
color-scheme='prefer-dark'
dark-accent-color=['0.835', '0.38', '0.6']
dark-bguri='file:///usr/share/backgrounds/f43/default/f43-01-night.jxl'
default-font='Sans 12'
fgcolor=['1.0', '1.0', '1.0']
halpha=0.25
hcolor=['0.835', '0.38', '0.6']
hscd-color=['0.835', '0.38', '0.6']
import-export=false
iscolor=['0.125', '0.125', '0.125']
light-bguri='file:///usr/share/backgrounds/f43/default/f43-01-day.jxl'
mbcolor=['1.0', '1.0', '1.0']
mbgcolor=['0.125', '0.125', '0.125']
mfgcolor=['1.0', '1.0', '1.0']
mhcolor=['0.835', '0.38', '0.6']
mscolor=['0.835', '0.38', '0.6']
mshcolor=['1.0', '1.0', '1.0']
neon=false
palette1=['100', '100', '100']
palette10=['100', '100', '100']
palette11=['100', '100', '100']
palette12=['100', '100', '100']
palette2=['100', '100', '100']
palette3=['100', '100', '100']
palette4=['100', '100', '100']
palette5=['100', '100', '100']
palette6=['100', '100', '100']
palette7=['100', '100', '100']
palette8=['100', '100', '100']
palette9=['100', '100', '100']
reloadstyle=true
shcolor=['0', '0', '0']
smbgcolor=['0.125', '0.125', '0.125']
vw-color=['0.835', '0.38', '0.6']
winbcolor=['0.835', '0.38', '0.6']
EOF
{{ end -}}
